# Copy to .env for local development. On Railway these are set in the dashboard.

# Postgres connection string. Railway provides this automatically.
DATABASE_URL=postgresql://postgres:password@localhost:5432/arcanova

# Set to "true" only if your Postgres requires SSL (e.g. Railway public URL).
DATABASE_SSL=false

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Port the server listens on. Railway sets this automatically.
PORT=4000
